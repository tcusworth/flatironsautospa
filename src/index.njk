---
layout: layouts/base.njk
title: "Flatirons Auto Spa | Premium Auto Detailing in Boulder & Longmont, CO"
description: "Flatirons Auto Spa provides premium interior detailing, exterior detailing, ceramic coatings, paint polishing, and vehicle spa packages for Boulder and Longmont drivers."
ogTitle: "Premium Auto Detailing in Boulder & Longmont, CO"
ogDescription: "High-end vehicle detailing, ceramic protection, polishing, and deep interior care from Flatirons Auto Spa."
preloadImage: "/assets/images/hero-2.png"
schemaKey: home
sitemapPriority: 1.0
sitemapChangefreq: weekly
---
<section class="hero" id="top" aria-label="{{ site.name }} premium vehicle detailing">
  <div class="hero-media" aria-hidden="true">
    {%- for img in home.hero.images %}
    <img class="hero-slide{% if loop.first %} is-active{% endif %}" src="/assets/images/{{ img }}" alt="">
    {%- endfor %}
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content reveal is-visible">
    <p class="eyebrow">{{ home.hero.eyebrow }}</p>
    <h1>{{ home.hero.heading }}</h1>
    <p class="hero-copy">{{ home.hero.copy }}</p>
    <div class="hero-actions">
      <a class="button primary" href="{{ site.phoneHref }}">Schedule a detail</a>
      <a class="button secondary" href="/#packages">View packages</a>
    </div>
  </div>
</section>

<section class="answer-strip" aria-label="Quick answer">
  <p><strong>Quick answer:</strong> {{ home.quickAnswer }}</p>
</section>

<section class="section split" id="about">
  <div class="media-stack reveal is-visible">
    <img src="/assets/images/{{ home.about.image }}" alt="{{ home.about.imageAlt }}">
    <div class="floating-stat">
      <strong>{{ home.about.stat.value }}</strong>
      <span>{{ home.about.stat.label }}</span>
    </div>
  </div>
  <div class="section-copy reveal is-visible">
    <p class="eyebrow">{{ home.about.eyebrow }}</p>
    <h2>{{ home.about.heading }}</h2>
    <p>{{ home.about.copy }}</p>
    <ul class="check-list">
      {%- for item in home.about.checklist %}
      <li>{{ item }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section service-band" id="services">
  <div class="section-heading reveal is-visible">
    <p class="eyebrow">{{ home.services.eyebrow }}</p>
    <h2>{{ home.services.heading }}</h2>
    <p>{{ home.services.intro }}</p>
  </div>
  <div class="service-grid">
    {%- for card in home.services.cards %}
    <article class="service-card reveal{% if loop.index <= 2 %} is-visible{% endif %}">
      <img src="/assets/images/{{ card.image }}" alt="{{ card.alt }}">
      <div>
        <h3>{{ card.title }}</h3>
        <p>{{ card.text }}</p>
        <a class="text-link" href="{{ card.url }}">{{ card.linkLabel }}</a>
      </div>
    </article>
    {%- endfor %}
  </div>
  <div class="service-link-grid reveal" aria-label="More service pages">
    {%- for link in home.services.moreLinks %}
    <a href="{{ link.url }}">{{ link.label }}</a>
    {%- endfor %}
  </div>
</section>

<section class="section packages" id="packages">
  <div class="section-heading reveal">
    <p class="eyebrow">{{ home.packages.eyebrow }}</p>
    <h2>{{ home.packages.heading }}</h2>
  </div>
  <div class="pricing-grid">
    {%- for pkg in home.packages.items %}
    <article class="price-card{% if pkg.featured %} featured{% endif %} reveal">
      <p class="tier">{{ pkg.tier }}</p>
      <h3>{{ pkg.name }}</h3>
      <div class="price">${{ pkg.price }} <span>sedan</span></div>
      <p class="suv">${{ pkg.suvPrice }} SUV</p>
      <ul>
        {%- for f in pkg.features %}
        <li>{{ f }}</li>
        {%- endfor %}
      </ul>
      <a href="{{ site.phoneHref }}">{{ pkg.cta }}</a>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="section results" id="results">
  <div class="results-copy reveal">
    <p class="eyebrow">{{ home.results.eyebrow }}</p>
    <h2>{{ home.results.heading }}</h2>
    <p>{{ home.results.copy }}</p>
  </div>
  <div class="results-gallery" aria-label="Detailing imagery">
    {%- for img in home.results.images %}
    <img class="reveal" src="/assets/images/{{ img.file }}" alt="{{ img.alt }}">
    {%- endfor %}
  </div>
</section>

<section class="section local-links" id="local-seo">
  <div class="section-heading reveal">
    <p class="eyebrow">{{ home.local.eyebrow }}</p>
    <h2>{{ home.local.heading }}</h2>
    <p>{{ home.local.intro }}</p>
  </div>
  <div class="local-grid">
    {%- for card in home.local.cards %}
    <a class="local-card reveal" href="{{ card.url }}">
      <span>{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
      <strong>{{ card.title }}</strong>
      <p>{{ card.text }}</p>
    </a>
    {%- endfor %}
  </div>
</section>

<section class="process">
  <div class="section-heading reveal">
    <p class="eyebrow">{{ home.process.eyebrow }}</p>
    <h2>{{ home.process.heading }}</h2>
  </div>
  <div class="process-line">
    {%- for step in home.process.steps %}
    <article class="step reveal">
      <span>{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
      <h3>{{ step.title }}</h3>
      <p>{{ step.text }}</p>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="section faq" id="faq">
  <div class="section-heading reveal">
    <p class="eyebrow">{{ home.faq.eyebrow }}</p>
    <h2>{{ home.faq.heading }}</h2>
  </div>
  <div class="faq-list">
    {%- for item in home.faq.items %}
    <details class="reveal"{% if loop.first %} open{% endif %}>
      <summary>{{ item.q }}</summary>
      <p>{{ item.a }}</p>
    </details>
    {%- endfor %}
  </div>
</section>

<section class="cta-panel">
  <div class="reveal">
    <p class="eyebrow">{{ home.cta.eyebrow }}</p>
    <h2>{{ home.cta.heading }}</h2>
  </div>
  <a class="button primary" href="{{ site.phoneHref }}">Call {{ site.phone }}</a>
</section>
