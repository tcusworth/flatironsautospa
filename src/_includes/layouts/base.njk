<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}">
    <meta name="author" content="{{ site.name }}">
    <meta name="theme-color" content="{{ site.themeColor }}">
    {%- if site.verification.google %}
    <meta name="google-site-verification" content="{{ site.verification.google }}">
    {%- endif %}
    {%- if site.verification.bing %}
    <meta name="msvalidate.01" content="{{ site.verification.bing }}">
    {%- endif %}
    {%- if not noindex %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {%- endif %}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {%- if preloadImage %}
    <link rel="preload" as="image" href="{{ preloadImage }}">
    {%- endif %}
    <link rel="stylesheet" href="/assets/styles.css">
    {%- if not noindex %}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ ogDescription or description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ ogImage or site.defaultOgImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle or title }}">
    <meta name="twitter:description" content="{{ ogDescription or description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.defaultOgImage }}">
    {%- endif %}
    {%- if jsonLd %}
    <script type="application/ld+json">
{{ jsonLd | dump(2) | safe }}
    </script>
    {%- elif schemaKey %}
    <script type="application/ld+json">
{{ schema[schemaKey] | dump(2) | safe }}
    </script>
    {%- endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header{% if solidHeader %} is-scrolled{% endif %}" data-header{% if solidHeader %} data-solid-header="true"{% endif %}>
      <a aria-label="{{ site.name }} home" class="brand" href="/">
        <img src="{{ site.logo }}" alt="{{ site.name }} logo" width="56" height="56">
        <span>{{ site.name }}</span>
      </a>
      <nav aria-label="Primary navigation">
        {%- for item in site.nav %}
        <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      {%- if headerCall %}
      <a class="header-cta" href="{{ site.phoneHref }}">Call {{ site.phone }}</a>
      {%- else %}
      <a class="header-cta" href="/contact/">Book now</a>
      {%- endif %}
    </header>

    <main id="main">
{{ content | safe }}
    </main>

    <footer class="site-footer">
      <div>
        <img src="{{ site.logo }}" alt="{{ site.name }} logo" width="68" height="68">
        <p>{{ site.footerBlurb }}</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        {%- for group in site.footerLinks %}
        <div>
          <strong>{{ group.title }}</strong>
          <ul>
            {%- for link in group.links %}
            <li><a href="{{ link.url }}">{{ link.label }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        {%- endfor %}
      </nav>
      <address>
        <strong>{{ site.name }}</strong><br>
        {{ site.address.street }}<br>
        {{ site.address.city }}, {{ site.address.region }} {{ site.address.zip }}<br>
        <a href="{{ site.phoneHref }}">{{ site.phone }}</a>
      </address>
    </footer>
    <div class="mobile-booking-bar" aria-label="Mobile booking shortcuts">
      <a href="{{ site.phoneHref }}">Call</a>
      <a href="/contact/">Book</a>
      <a href="/gallery/">Gallery</a>
    </div>
    <script src="/assets/main.js"></script>
  </body>
</html>
