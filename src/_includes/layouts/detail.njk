---
layout: layouts/base.njk
solidHeader: true
---
<section class="page-hero detail-hero">
  <div class="page-hero-media" aria-hidden="true"></div>
  <div class="page-hero-content reveal">
    {% include "breadcrumb.njk" %}
    <p class="eyebrow">{{ eyebrow }}</p>
    <h1>{{ heading }}</h1>
    <p>{% if slogan %}{{ slogan }} {% endif %}{{ lead }}</p>
  </div>
</section>
<section class="section detail-body">
  <aside>
    <div class="detail-panel reveal">
      <strong>{{ panelTitle }}</strong>
      <ul>
        {%- for item in panelItems %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </div>
    <div class="related-panel reveal">
      <h3>{{ relatedTitle or "Related services" }}</h3>
      <ul>
        {%- for link in related %}
        <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </aside>
  <article class="detail-copy reveal">
    {{ content | safe }}
    <a class="button primary" href="/contact/">{{ ctaLabel }}</a>
  </article>
</section>
{%- if packageCards %}
<section class="section packages">
  <div class="section-heading reveal">
    <p class="eyebrow">Pricing</p>
    <h2>{{ packagesHeading or "Packages" }}</h2>
    <p>Prices shown are starting prices. Call {{ site.phone }} to discuss your vehicle.</p>
  </div>
  <div class="pricing-grid pricing-grid--{{ packageCards | length }}">
    {%- for pkg in home.packages.items %}
    {%- if pkg.schemaId in packageCards %}
    <article class="price-card{% if pkg.featured %} featured{% endif %} reveal">
      <p class="tier">{{ pkg.tier }}</p>
      <h3>{{ pkg.name }}</h3>
      <div class="price">${{ pkg.price }} <span>sedan</span></div>
      <p class="suv">${{ pkg.suvPrice }} SUV</p>
      <ul>
        {%- for note in (packageNotes[pkg.schemaId] if packageNotes and packageNotes[pkg.schemaId] else pkg.features) %}
        <li>{{ note }}</li>
        {%- endfor %}
      </ul>
      <a href="{{ site.phoneHref }}">{{ pkg.cta }}</a>
    </article>
    {%- endif %}
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- if faqs %}
<section class="section faq">
  <div class="section-heading reveal">
    <p class="eyebrow">FAQs</p>
    <h2>Common questions.</h2>
  </div>
  <div class="faq-list">
    {%- for id in faqs %}
    {%- set item = home.faq.byId[id] %}
    <details class="reveal">
      <summary>{{ item.q }}</summary>
      <p>{{ item.a }}</p>
    </details>
    {%- endfor %}
  </div>
</section>
{%- endif %}
